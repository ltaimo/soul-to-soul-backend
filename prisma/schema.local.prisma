generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Supplier {
  id       Int    @id @default(autoincrement())
  name     String
  category String
  status   String @default("Active")
  leadTime String

  products  Product[]
  purchases Purchase[]
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  type      String   @default("Warehouse")
  address   String?
  notes     String?
  status    String   @default("Active")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks               WarehouseStock[]
  inventoryBatches     InventoryBatch[]
  purchases            Purchase[]
  sales                Sale[]
  movements            StockMovement[]     @relation("MovementWarehouse")
  sourceMovements      StockMovement[]     @relation("MovementSourceWarehouse")
  destinationMovements StockMovement[]     @relation("MovementDestinationWarehouse")
  sourceTransfers      StockTransfer[]     @relation("TransferSourceWarehouse")
  destinationTransfers StockTransfer[]     @relation("TransferDestinationWarehouse")
  commercialPartners   CommercialPartner[]

  @@index([status])
  @@index([type])
}

model Product {
  id                  Int    @id @default(autoincrement())
  sku                 String @unique
  name                String
  category            String
  type                String
  costPrice           Float
  sellingPrice        Float
  laborCostPerUnit    Float  @default(0.0)
  overheadCostPerUnit Float  @default(0.0)
  stock               Int    @default(0)
  status              String @default("Active")

  // New Product Management Fields
  brand                String?
  description          String?
  barcode              String?
  imageUrl             String?
  storeFeatured        Boolean @default(false)
  unit                 String  @default("pcs")
  minStock             Int     @default(0)
  loyaltyPointsEarned  Int     @default(0)
  redemptionPointsCost Int     @default(0)

  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  stockMovements   StockMovement[]
  purchases        PurchaseItem[]
  inventoryBatches InventoryBatch[]
  warehouseStocks  WarehouseStock[]
  transferItems    StockTransferItem[]

  // BOM Relationships
  bomAsFinishedGood BillOfMaterial[] @relation("BOM_FinishedGood")
  bomAsComponent    BillOfMaterial[] @relation("BOM_Component")

  saleItems SaleItem[]
}

model Purchase {
  id            Int      @id @default(autoincrement())
  supplierId    Int
  warehouseId   Int?
  warehouseName String?
  date          DateTime @default(now())
  status        String   @default("Received")
  totalValue    Float

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  warehouse Warehouse?     @relation(fields: [warehouseId], references: [id])
  items     PurchaseItem[]
}

model PurchaseItem {
  id         Int   @id @default(autoincrement())
  purchaseId Int
  productId  Int
  quantity   Int
  unitCost   Float

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
}

model InventoryBatch {
  id          Int       @id @default(autoincrement())
  productId   Int
  warehouseId Int?
  batchNumber String
  quantity    Int
  unitCost    Float
  mfgDate     DateTime?
  expiryDate  DateTime?

  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
}

model StockMovement {
  id                     Int      @id @default(autoincrement())
  productId              Int
  warehouseId            Int?
  sourceWarehouseId      Int?
  destinationWarehouseId Int?
  transferId             Int?
  responsibleId          Int?
  responsibleName        String?
  quantity               Int // Positive for receive, negative for deduction
  movementType           String // "PO_RECEIVE", "SALE", "ADJUSTMENT", "INITIAL_ADJUSTMENT"
  status                 String   @default("Posted")
  unitCost               Float
  date                   DateTime @default(now())
  reference              String? // Audit/Note reference

  product              Product        @relation(fields: [productId], references: [id])
  warehouse            Warehouse?     @relation("MovementWarehouse", fields: [warehouseId], references: [id])
  sourceWarehouse      Warehouse?     @relation("MovementSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse?     @relation("MovementDestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  transfer             StockTransfer? @relation(fields: [transferId], references: [id])

  @@index([warehouseId])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([transferId])
  @@index([movementType])
}

model WarehouseStock {
  id          Int      @id @default(autoincrement())
  warehouseId Int
  productId   Int
  quantity    Int      @default(0)
  minStock    Int      @default(0)
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@index([productId])
}

model StockTransfer {
  id                     Int       @id @default(autoincrement())
  transferNumber         String    @unique
  sourceWarehouseId      Int
  destinationWarehouseId Int
  status                 String    @default("In Transit")
  notes                  String?
  requestedById          Int?
  requestedByName        String?
  confirmedById          Int?
  confirmedByName        String?
  shippedAt              DateTime?
  receivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sourceWarehouse      Warehouse           @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse           @relation("TransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  items                StockTransferItem[]
  movements            StockMovement[]

  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
}

model StockTransferItem {
  id         Int   @id @default(autoincrement())
  transferId Int
  productId  Int
  quantity   Int
  unitCost   Float @default(0)

  transfer StockTransfer @relation(fields: [transferId], references: [id])
  product  Product       @relation(fields: [productId], references: [id])

  @@index([productId])
}

model BillOfMaterial {
  id               Int   @id @default(autoincrement())
  finishedGoodId   Int
  componentId      Int
  quantityRequired Float

  finishedGood Product @relation("BOM_FinishedGood", fields: [finishedGoodId], references: [id])
  component    Product @relation("BOM_Component", fields: [componentId], references: [id])

  @@unique([finishedGoodId, componentId])
}

model Customer {
  id              Int      @id @default(autoincrement())
  customerCode    String?  @unique
  fullName        String
  phone           String?
  email           String?
  loyaltyTier     String   @default("Standard")
  discountPercent Float    @default(0)
  loyaltyPoints   Int      @default(0)
  notes           String?
  status          String   @default("Active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sales Sale[]

  @@index([email])
  @@index([phone])
  @@index([customerCode])
}

model CommercialPartner {
  id                 Int      @id @default(autoincrement())
  name               String
  type               String   @default("Seller")
  warehouseId        Int?
  phone              String?
  email              String?
  commissionRate     Float    @default(0)
  agreementType      String   @default("Direct Sale")
  pricePolicy        String   @default("Standard")
  priceAdjustment    Float    @default(0)
  paymentTerms       String?
  settlementCycle    String   @default("On Sale")
  creditLimit        Float    @default(0)
  defaultSaleChannel String   @default("Store")
  trackingEnabled    Boolean  @default(false)
  notes              String?
  status             String   @default("Active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sales     Sale[]
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([type])
  @@index([status])
  @@index([phone])
  @@index([agreementType])
  @@index([warehouseId])
}

model Sale {
  id                  Int      @id @default(autoincrement())
  customerId          Int?
  warehouseId         Int?
  commercialPartnerId Int?
  warehouseName       String?
  customerName        String?
  customerEmail       String?
  customerPhone       String?
  deliveryAddress     String?
  sellerId            Int?
  sellerName          String?
  sellerType          String?
  commissionRate      Float    @default(0)
  commissionAmount    Float    @default(0)
  channel             String   @default("Store")
  orderReference      String?
  fulfillmentStatus   String   @default("Delivered")
  paymentMethod       String   @default("Cash")
  paymentStatus       String   @default("Paid")
  paymentReference    String?
  paymentProviderData String?
  notificationStatus  String   @default("Not Required")
  amountPaid          Float    @default(0)
  changeGiven         Float    @default(0)
  pointsEarned        Int      @default(0)
  pointsRedeemed      Int      @default(0)
  date                DateTime @default(now())
  totalRevenue        Float
  totalCogs           Float

  items             SaleItem[]
  customer          Customer?          @relation(fields: [customerId], references: [id])
  warehouse         Warehouse?         @relation(fields: [warehouseId], references: [id])
  commercialPartner CommercialPartner? @relation(fields: [commercialPartnerId], references: [id])

  @@index([channel])
  @@index([fulfillmentStatus])
  @@index([paymentStatus])
  @@index([orderReference])
}

model SaleItem {
  id                   Int   @id @default(autoincrement())
  saleId               Int
  productId            Int
  quantity             Int
  unitSellingPrice     Float
  unitCogs             Float // Locked COGS at time of sale
  loyaltyPointsEarned  Int   @default(0)
  redemptionPointsCost Int   @default(0)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model SystemSetting {
  id                 Int      @id @default(1)
  companyName        String   @default("Soul2Soul")
  companyLogo        String?
  companyPhone       String?
  companyWhatsApp    String?
  companyEmail       String?
  companyAddress     String?
  companyWebsite     String?
  instagramUrl       String?
  facebookUrl        String?
  tiktokUrl          String?
  defaultCurrency    String   @default("MZN")
  currencySymbol     String   @default("MT")
  decimalFormatting  Int      @default(2)
  hrPaymentTypes     String   @default("Salary,Rent,Advance,Bonus,Transport,Utilities,Commission,Other")
  paymentMethods     String   @default("Cash,M-Pesa,E-Mola,Card,Bank Transfer")
  warehouseTypes     String   @default("Warehouse,Shop,Storage,Transit")
  productCategories  String   @default("Skincare,Haircare,Beard Care,Raw Material,Packaging")
  productTypes       String   @default("Finished Good,Raw Material,Packaging")
  productUnits       String   @default("pcs,kg,g,l,ml,box")
  attendanceStatuses String   @default("Present,Absent,Late,Half Day,Leave")
  payFrequencies     String   @default("Monthly,Weekly,Daily,Hourly")
  hrRoles            String   @default("Manager,Cashier,Salesperson,Stock Manager,Production Assistant,Administrator")
  hrDepartments      String   @default("Sales,Store,Warehouse,Production,Administration,Finance")
  updatedAt          DateTime @updatedAt
}

model User {
  id                 Int      @id @default(autoincrement())
  fullName           String
  email              String?  @unique
  username           String?  @unique
  phone              String?  @unique
  employeeId         Int?
  passwordHash       String
  mustChangePassword Boolean  @default(false)
  role               String   @default("staff") // admin, manager, staff, viewer
  status             String   @default("active") // active, inactive
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          Int?
  updatedBy          Int?

  @@index([employeeId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  userName   String?
  userEmail  String?
  userRole   String?
  action     String
  entityType String?
  entityId   String?
  method     String
  path       String
  ipAddress  String?
  userAgent  String?
  machine    String?
  metadata   String?
  statusCode Int?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}

model Employee {
  id               Int      @id @default(autoincrement())
  fullName         String
  phone            String?
  email            String?
  role             String?
  department       String?
  performanceMode  String   @default("Attendance")
  salary           Float    @default(0)
  payFrequency     String   @default("Monthly")
  startDate        DateTime @default(now())
  emergencyContact String?
  notes            String?
  status           String   @default("Active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payments   HrPayment[]
  attendance AttendanceRecord[]
  goals      WorkGoal[]

  @@index([phone])
  @@index([status])
}

model HrPayment {
  id            Int       @id @default(autoincrement())
  employeeId    Int?
  type          String
  description   String
  amount        Float
  periodicity   String    @default("One-time")
  periodStart   DateTime?
  periodEnd     DateTime?
  dueDate       DateTime?
  nextDueDate   DateTime?
  paidDate      DateTime?
  method        String?
  status        String    @default("Pending")
  source        String    @default("Manual")
  payrollMonth  String?
  receiptNumber String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee Employee? @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, type, payrollMonth])
  @@index([type])
  @@index([periodicity])
  @@index([status])
  @@index([dueDate])
  @@index([nextDueDate])
  @@index([payrollMonth])
}

model AttendanceRecord {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime
  status     String   @default("Present")
  checkIn    String?
  checkOut   String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

model WorkGoal {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("Pending")
  progress    Int       @default(0)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([dueDate])
}

model FundRequest {
  id             Int       @id @default(autoincrement())
  requestNumber  String    @unique
  requesterId    Int?
  requesterName  String
  requesterEmail String?
  requesterRole  String?
  department     String?
  category       String
  title          String
  description    String?
  amount         Float
  currency       String    @default("MZN")
  neededBy       DateTime?
  priority       String    @default("Normal")
  paymentMethod  String?
  payeeName      String?
  payeePhone     String?
  payeeBank      String?
  status         String    @default("Pending")
  reviewedById   Int?
  reviewedByName String?
  reviewedAt     DateTime?
  reviewNotes    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([requesterId])
  @@index([status])
  @@index([createdAt])
  @@index([category])
}
